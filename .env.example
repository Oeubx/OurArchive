# ==============================================================================
# OurArchive Environment Configuration Matrix
# ==============================================================================
# Copy this file to .env.local for local development.
# Do NOT commit .env.local or any actual secret credentials to git.

# ------------------------------------------------------------------------------
# 1. Platform & Application URLs (Public)
# ------------------------------------------------------------------------------
# Base canonical URL of the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Supabase Backend-as-a-Service (BaaS)
# ------------------------------------------------------------------------------
# Supabase Project API Gateway URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anonymous Public API Key (Project Settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (Project Settings -> API -> service_role secret)
# CRITICAL SECRET: Grants full database bypass access. Never expose to client!
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 3. Google Cloud Services
# ------------------------------------------------------------------------------
# Google Drive REST API v3 Key (Used exclusively for read-only metadata inspection)
GOOGLE_DRIVE_API_KEY="AIzaSy..."

# Google Safe Browsing API v4 Key (Used for automated malware/phishing URL scanning)
GOOGLE_SAFE_BROWSING_API_KEY="AIzaSy..."

# ------------------------------------------------------------------------------
# 4. Anti-Bot Defense (Cloudflare Turnstile)
# ------------------------------------------------------------------------------
# Public Site Key for Client-side Turnstile Widget
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY="0x4AAAAAA..."

# Secret Key for Server-side Token Validation (/api/links/submit)
CLOUDFLARE_TURNSTILE_SECRET_KEY="0x4AAAAAA..."

# ------------------------------------------------------------------------------
# 5. Community Safety & Takedowns
# ------------------------------------------------------------------------------
# Public Emergency Takedown Contact Email
NEXT_PUBLIC_TAKEDOWN_EMAIL="takedown-ourarchive@proton.me"


# ------------------------------------------------------------------------------
# 6. Developer Social Media, Portfolio & Connect (Public)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEV_EMAIL="your-personal-email@gmail.com"
NEXT_PUBLIC_DEV_TWITTER="https://x.com/yourhandle"
NEXT_PUBLIC_DEV_GITHUB="https://github.com/Oeubx"
NEXT_PUBLIC_PROJECT_REPO="https://github.com/Oeubx/OurArchive"
NEXT_PUBLIC_DEV_LINKEDIN="https://linkedin.com/in/yourprofile"
# Set to your live URL or leave as default 'under-development'
NEXT_PUBLIC_DEV_PORTFOLIO="under-development"
